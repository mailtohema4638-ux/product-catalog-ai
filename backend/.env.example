APP_NAME="Product Catalogue API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Persistence (enquiries only). SQLite for the PoC; swap for Postgres/RDS via DB_* vars.
DB_CONNECTION=sqlite

# Stateless JSON API: no cookies, no sessions.
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# file -> redis (ElastiCache) needs no code change.
CACHE_STORE=file
# sync -> sqs/redis later; jobs are already queue-ready.
QUEUE_CONNECTION=sync

# --- Email (EmailProviderInterface) ---
# mail = Laravel mailer, transport chosen by MAIL_MAILER (Mailpit in docker compose); mock = records only, no delivery.
EMAIL_PROVIDER=mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@catalogue.test"
MAIL_FROM_NAME="${APP_NAME}"
# Recipient of enquiry notifications. Server-side only; never taken from requests.
SALES_INBOX_ADDRESS="sales@catalogue.test"

# --- Product source (ProductProviderInterface) ---
CATALOGUE_PROVIDER=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
FAKESTORE_TIMEOUT_SECONDS=4
FAKESTORE_RETRIES=1
# Comma-separated source product IDs curated as "top rated" on the home page.
FEATURED_PRODUCT_IDS=12,11,3,18,5
CATALOGUE_CACHE_TTL_SECONDS=600
CATALOGUE_STALE_TTL_SECONDS=86400
CATEGORY_TOP_RATED_COUNT=3

# Comma-separated trusted proxy IPs/CIDRs (the gateway). Empty = trust none.
TRUSTED_PROXIES=

# Cross-origin access is off by default (same-origin gateway). Comma-separated origins to allow.
CORS_ALLOWED_ORIGINS=
