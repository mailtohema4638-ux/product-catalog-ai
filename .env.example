# Optional overrides for `docker compose up`. Copy to `.env` to use; never commit `.env`.
# Any variable from backend/.env.example can be overridden here.

WEB_PORT=8080
MAILPIT_UI_PORT=8025

# Where enquiry emails go (shown in Mailpit locally).
# SALES_INBOX_ADDRESS=sales@catalogue.test

# Curated "top rated" products on the home page (source product IDs).
# FEATURED_PRODUCT_IDS=1,2,3,4,5

# Switch providers without code changes.
# EMAIL_PROVIDER=mail   # or "mock" (records only, delivers nothing)
# CATALOGUE_PROVIDER=fakestore
